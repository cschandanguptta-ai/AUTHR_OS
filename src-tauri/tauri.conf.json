{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AUTHR_OS",
  "version": "3.0.0",
  "identifier": "com.authros.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AUTHR_OS — Author's Cockpit",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": []
  }
}
