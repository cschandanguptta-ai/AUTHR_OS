{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AUTHR_OS",
  "version": "3.0.0",
  "identifier": "com.authros.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AUTHR_OS — Author's Cockpit",
        "width": 1600,
        "height": 1000,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [],
    "category": "Productivity",
    "shortDescription": "AUTHR_OS — AI-native novel workstation with studio-grade audiobook pipeline",
    "longDescription": "Local-first authoring cockpit: Lexical AST canvas, lookahead TTS, 3-layer DSP mastering, vector RAG, and 1-click EPUB 3 / DOCX / Typst PDF / ACX M4B publishing.",
    "windows": {
      "wix": {
        "language": "en-US",
        "template": null
      },
      "nsis": {
        "installMode": "both",
        "languages": ["English"]
      },
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "targets": ["dmg", "app"],
      "signingIdentity": null
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/authr-os/authr-os/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_AUTHR_UPDATER_PUBKEY (generate: release_manifest → latest.json public_key)"
    }
  }
}
